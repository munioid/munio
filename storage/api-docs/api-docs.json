    "components": {
        "schemas": {
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "admin@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "admin123"
                    }
                },
                "type": "object"
            },
            "UpdateProfileRequest": {
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "User Name"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "token": {
                        "type": "string"
                    },
                    "token_type": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "LogoutResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Logout berhasil."
                    }
                },
                "type": "object"
            },
            "ProfileResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "example": "User Name"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "type": "object"
            },
            "UpdateProfileResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Profile berhasil dirubah."
                    }
                },
                "type": "object"
            },
            "BaseCollectionResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "data": {
                        "type": "array",
                        "items": {}
                    }
                },
                "type": "object"
            },
            "BaseItemResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "data": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "BasePaginationResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "data": {
                        "type": "array",
                        "items": {}
                    },
                    "meta": {
                        "properties": {
                            "pagination": {
                                "properties": {
                                    "total": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "count": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "per_page": {
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "current_page": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "total_pages": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "BaseSuccessResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "PostResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string",
                        "example": "Voluptatum sint quas dicta qui qui ad"
                    },
                    "slug": {
                        "type": "string",
                        "example": "voluptatum-sint-quas-dicta-qui-qui-ad"
                    },
                    "excerpt": {
                        "type": "string",
                        "example": "Deserunt assumenda vero occaecati quia nam rerum iure est"
                    },
                    "content": {
                        "type": "string",
                        "example": "<p>Qui qui sed libero a et. Labore impedit consequuntur voluptates autem. Corrupti doloremque dolorem nostrum ut.</p>"
                    },
                    "source": {
                        "type": "string",
                        "format": "uri",
                        "example": "http://www.ruecker.biz/facere-eaque-delectus-eum-et-sequi"
                    },
                    "category": {
                        "$ref": "#/components/schemas/CategoryResponse"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TagResponse"
                        }
                    },
                    "published_by": {
                        "type": "string",
                        "example": "Admin"
                    },
                    "published_at": {
                        "type": "string",
                        "example": "2026-06-11 10:24:15"
                    },
                    "covers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FileResponse"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "example": "2026-06-11 10:24:15"
                    },
                    "updated_at": {
                        "type": "string",
                        "example": "2026-06-11 10:24:15"
                    }
                },
                "type": "object"
            },
            "EventPackageResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "example": "Package 1"
                    },
                    "code": {
                        "type": "string",
                        "example": "P1"
                    },
                    "price": {
                        "type": "decimal",
                        "example": 100000
                    },
                    "stocks": {
                        "type": "integer",
                        "example": 100
                    }
                },
                "type": "object"
            },
            "EventResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string",
                        "example": "Qui numquam inventore sunt aut sunt assumenda"
                    },
                    "slug": {
                        "type": "string",
                        "example": "qui-numquam-inventore-sunt-aut-sunt-assumenda"
                    },
                    "excerpt": {
                        "type": "string",
                        "example": "Quasi asperiores officia ducimus rerum"
                    },
                    "content": {
                        "type": "string",
                        "example": "<p>Ipsa nihil repellat cupiditate eligendi.</p>"
                    },
                    "start_at": {
                        "type": "string",
                        "format": "date"
                    },
                    "end_at": {
                        "type": "string",
                        "format": "date"
                    },
                    "cover": {
                        "$ref": "#/components/schemas/FileResponse"
                    },
                    "category": {
                        "$ref": "#/components/schemas/CategoryResponse"
                    },
                    "published": {
                        "type": "boolean"
                    },
                    "published_at": {
                        "type": "string",
                        "format": "datetime",
                        "example": "2026-06-12 10:24:15"
                    },
                    "pricing_type": {
                        "type": "string",
                        "example": "package"
                    },
                    "price": {
                        "type": "decimal",
                        "example": 100000
                    },
                    "stocks": {
                        "type": "integer",
                        "example": 100
                    },
                    "external_url": {
                        "type": "string",
                        "example": "http://www.ruecker.biz/facere-eaque-delectus-eum-et-sequi"
                    },
                    "packages": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/EventPackageResponse"
                        }
                    }
                },
                "type": "object"
            },
            "FileResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "file_name": {
                        "type": "string"
                    },
                    "file_path": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "CategoryResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "example": "Aperiam"
                    },
                    "slug": {
                        "type": "string",
                        "example": "aperiam"
                    },
                    "description": {
                        "type": "string",
                        "example": "Molestiae consequatur dolorem sed quae autem."
                    }
                },
                "type": "object"
            },
            "TagResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "example": "Ipsam"
                    },
                    "slug": {
                        "type": "string",
                        "example": "ipsam"
                    },
                    "description": {
                        "type": "string",
                        "example": "Rerum quis architecto sit itaque."
                    }
                },
                "type": "object"
            }
        },
        "parameters": {
            "IdParameter": {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                    "format": "uuid"
                }
            },
            "PageParameter": {
                "name": "page",
                "in": "query",
                "description": "Page of pagination",
                "required": false,
                "schema": {
                    "type": "integer"
                }
            },
            "SearchParameter": {
                "name": "search",
                "in": "query",
                "description": "Search keyword",
                "required": false,
                "schema": {
                    "type": "string"
                }
            }
        },
        "securitySchemes": {
            "bearerToken": {
                "type": "http",
                "description": "Login dengan bearer token",
                "name": "bearerToken",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
